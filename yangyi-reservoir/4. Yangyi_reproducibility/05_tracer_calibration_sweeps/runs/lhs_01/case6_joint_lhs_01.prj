    <output>
      <type>VTK</type>
      <prefix>case6_joint_lhs_01</prefix>
      <timesteps>
        <pair>
          <repeat>1</repeat>
          <each_steps>30</each_steps>
        </pair>
        <pair>
          <repeat>479</repeat>
          <each_steps>1</each_steps>
