          <reltol>1e-6</reltol>
          <abstol>1e-8</abstol>
        </convergence_criterion>
        <time_discretization>
          <type>BackwardEuler</type>
        </time_discretization>
        <time_stepping>
          <type>FixedTimeStepping</type>
          <t_initial>0</t_initial>
          <t_end>20563200</t_end>
          <timesteps>
            <pair>
              <repeat>30</repeat>
              <delta_t>60</delta_t>
            </pair>
            <pair>
              <repeat>5758</repeat>
              <delta_t>900</delta_t>
            </pair>
            <pair>
              <repeat>4272</repeat>
              <delta_t>3600</delta_t>
